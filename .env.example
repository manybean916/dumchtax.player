# ─────────────────────────────────────────────────────────────
#  Dumchtax Player — 환경변수 예시 (PLACEHOLDER ONLY)
# ─────────────────────────────────────────────────────────────
#  ⚠️  이 파일은 "예시 템플릿"입니다. 실제 키를 여기에 넣지 마세요.
#  ⚠️  실제 키는 절대 커밋하지 마세요. (.env 는 .gitignore 로 제외됨)
#
#  실제 키는 Netlify 대시보드에 등록합니다:
#    Site settings → Environment variables → Add a variable
#  로컬에서 `netlify dev` 로 테스트할 때만 .env 파일에 실제 키를 넣습니다.
# ─────────────────────────────────────────────────────────────

# 사진 무드 분석 (Google Gemini)
#   발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 무드 기반 음악 검색 (YouTube Data API v3)
#   발급: https://console.cloud.google.com  (YouTube Data API v3 활성화)
YOUTUBE_API_KEY=your_youtube_data_api_key_here
